# Copy to .env and edit. NEVER commit .env (it is git-ignored).
# Local PowerShell use: values below apply as-is. Docker compose forces APP_ENV=production, HOST, PORT and DATA_DIR
# itself, so only JWT_SECRET (required), CORS_ORIGINS, MAX_UPLOAD_BYTES etc. matter there.
APP_ENV=development
# REQUIRED in production, >= 32 chars. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_TTL_SECONDS=86400
HOST=127.0.0.1
PORT=8000
DATA_DIR=./data
# Comma-separated browser origins allowed to call the API cross-origin (leave empty when the UI is served by this server)
CORS_ORIGINS=
# Only set if the UI is hosted on a different origin than the API, e.g. https://api.example.com
API_BASE_URL=
MAX_UPLOAD_BYTES=10485760
LOG_REQUESTS=1
